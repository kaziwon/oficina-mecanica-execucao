<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Include>[OficinaMecanica.Execucao.Domain]*,[OficinaMecanica.Execucao.Application]*,[OficinaMecanica.Execucao.InterfaceAdapters]*,[OficinaMecanica.Execucao.Infrastructure]*,[OficinaMecanica.Execucao.Api]*</Include>
          <ExcludeByFile>**/Persistence/Migrations/**</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
