apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mongo
  namespace: "${namespace}"
spec:
  serviceName: mongo
  replicas: 1
  selector:
    matchLabels: {app: mongo}
  template:
    metadata:
      labels: {app: mongo}
    spec:
      automountServiceAccountToken: false
      securityContext: {fsGroup: 999}
      initContainers:
        - name: keyfile
          image: busybox:1.37@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
          command: [sh, -ec, 'cp /secret/keyfile /keys/keyfile; chown 999:999 /keys/keyfile; chmod 400 /keys/keyfile']
          securityContext: {runAsUser: 0}
          volumeMounts:
            - {name: secret, mountPath: /secret, readOnly: true}
            - {name: keys, mountPath: /keys}
      containers:
        - name: mongo
          image: mongo:8.0@sha256:b9924c330a8bbc5800fe9c69f04a84e221eca7b28fd049a0354147d9908fa142
          args: [--replSet, rs0, --bind_ip_all, --keyFile, /keys/keyfile, --wiredTigerCacheSizeGB, '0.25']
          ports: [{name: mongo, containerPort: 27017}]
          envFrom: [{secretRef: {name: database-secrets}}]
          resources:
            requests: {cpu: 100m, memory: 384Mi}
            limits: {cpu: 750m, memory: 768Mi}
          startupProbe:
            exec:
              command: [sh, -ec, 'mongosh --quiet -u "$MONGO_INITDB_ROOT_USERNAME" -p "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin --eval "db.adminCommand({ping:1}).ok"']
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec:
              command: [sh, -ec, 'mongosh --quiet -u "$MONGO_INITDB_ROOT_USERNAME" -p "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin --eval "db.adminCommand({ping:1}).ok"']
            periodSeconds: 10
          livenessProbe:
            tcpSocket: {port: mongo}
            periodSeconds: 10
          volumeMounts:
            - {name: data, mountPath: /data/db}
            - {name: keys, mountPath: /keys, readOnly: true}
            - {name: bootstrap, mountPath: /docker-entrypoint-initdb.d/mongo-init.js, subPath: mongo-init.js, readOnly: true}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: database-data}
        - name: keys
          emptyDir: {}
        - name: secret
          secret:
            secretName: database-secrets
            items: [{key: keyfile, path: keyfile, mode: 256}]
        - name: bootstrap
          configMap: {name: mongo-bootstrap}
